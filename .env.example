# ==========================================================================
# 课题组主页环境配置
# ==========================================================================
# 使用方法：复制本文件为 .env，然后把下面的占位值替换为真实值。
# 注意：.env 已列入 .gitignore，不会被提交，因此可以放私密配置。
# ==========================================================================

# [必填] 网站正式对外地址，影响 canonical、sitemap、hreflang 等 SEO 标签。
# 本地预览时可临时改为 http://localhost:4321/
PUBLIC_SITE_URL=https://your-lab-site.example.edu.cn

# [CMS 必填] Decap CMS 后台连接哪个 GitHub 仓库，格式 用户名/仓库名
CMS_GITHUB_REPO=your-github-username/your-lab-site

# [CMS 可选] 主分支名，通常为 main
CMS_BRANCH=main

# [CMS 可选] GitHub OAuth 中转服务地址，用于后台登录鉴权。
# 需要先在 GitHub OAuth App 中登记对应的 redirect 地址，
# 部署完成后此处填实际生效的地址。
CMS_OAUTH_BASE_URL=