---
import { b } from '../utils/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { summarizeText } from '../utils/seo';

const lifeEntries = await getCollection('life');
const entry =
  lifeEntries.find((item) => item.id === 'lab-life_cn.md') ||
  lifeEntries.find((item) => /_cn\.md$/i.test(item.id));

if (!entry) {
  throw new Error('Missing Chinese life content: src/content/life/**/*_cn.md');
}

const { Content } = await render(entry);
const pageTitle = entry.data.title || '实验室日常与设备';
const pageDesc = summarizeText(entry.body) || '查看课题组的实验室环境、主要设备与组内日常。';
---
<BaseLayout title={pageTitle} desc={pageDesc} lang="zh" pathPrefix="">
  <section class="detail-shell">
    <article class="card detail-hero" data-reveal>
      <h1 class="page-title">{pageTitle}</h1>
    </article>

    <article class="card detail-content news-article" data-reveal>
      <Content />
    </article>

    <div class="back-row" data-reveal>
      <a class="btn btn-primary" href={b('/')}>返回首页</a>
      <a class="btn btn-ghost" href={b('/members/')}>查看成员</a>
      <a class="btn btn-ghost" href={b('/join/')}>招生合作</a>
    </div>
  </section>
</BaseLayout>